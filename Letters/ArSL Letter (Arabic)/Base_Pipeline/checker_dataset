import os
import cv2
import random

# 1. SET YOUR DATASET DIRECTORY HERE
DATASET_DIR = r"M:\Term 10\Grad\Letters Datasets\Dataset (ArASL)\ArASL Database\ArASL_Database"

print(f"Analyzing dataset located at: {os.path.abspath(DATASET_DIR)}\n")

if not os.path.exists(DATASET_DIR):
    print(f"Error: Could not find the folder '{DATASET_DIR}'.")
    exit()

# Get all the class folders
classes = [d for d in os.listdir(DATASET_DIR) if os.path.isdir(os.path.join(DATASET_DIR, d))]

if not classes:
    print("No class folders found in the dataset directory.")
    exit()

for cls in classes:
    class_path = os.path.join(DATASET_DIR, cls)
    image_files = [f for f in os.listdir(class_path) if f.endswith(('.jpg', '.png', '.jpeg'))]
    
    print(f"=======================")
    print(f"Class: '{cls}'")
    print(f"Total files: {len(image_files)}")
    
    valid_count = 0
    corrupt_count = 0
    
    # Check for file corruption
    for img_name in image_files:
        img_path = os.path.join(class_path, img_name)
        img = cv2.imread(img_path)
        
        if img is None:
            corrupt_count += 1
            print(f"  [!] CORRUPTED FILE: {img_name}")
        else:
            valid_count += 1

    if corrupt_count > 0:
        print(f"Warning: Found {corrupt_count} unreadable images.")
    else:
        print("Status: All images are valid and readable.")
        
    # Show a random sample image to the user
    if valid_count > 0:
        random_file = random.choice(image_files)
        sample_path = os.path.join(class_path, random_file)
        sample_img = cv2.imread(sample_path)
        
        # Add a label to the image
        cv2.putText(sample_img, f"Class: {cls} (Press any key to continue)", (10, 40), 
                    cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 0), 2)
        
        print(f"-> Showing random sample. Press any key on the image window to check the next class...")
        cv2.imshow('Dataset Checker', sample_img)
        cv2.waitKey(0) # Waits indefinitely until you press a keyboard key

print("\n=======================")
print("Dataset check complete! All classes verified.")
cv2.destroyAllWindows()