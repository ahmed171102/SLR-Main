graph TD
    %% --- PHASE 1: DATA & TRAINING (The 4 Parallel Paths) ---
    subgraph Training_Phase [PHASE 1: TRAINING THE 4 BRAINS]
        direction TB
        
        %% Path 1: English Words
        subgraph EW [Model 1: English Words]
            D1[dataset: WLASL Videos] -->|Script: preprocess_english.py| MP1(MediaPipe: Extract Landmarks)
            MP1 -->|Save .npy files| F1[Features: 30 Frames x 1662 pts]
            F1 -->|Script: train_english.py| LSTM1{{LSTM Network}}
            LSTM1 -->|Output| M1[File: english_words.h5]
        end

        %% Path 2: Arabic Words
        subgraph AW [Model 2: Arabic Words]
            D2[dataset: KArSL Videos] -->|Script: organize_karsl.py| FOLDER[Re-Organized Folders]
            FOLDER -->|Script: preprocess_arabic.py| MP2(MediaPipe: Extract Landmarks)
            MP2 -->|Save .npy files| F2[Features: 30 Frames x 1662 pts]
            F2 -->|Script: train_arabic.py| LSTM2{{LSTM Network}}
            LSTM2 -->|Output| M2[File: arabic_words.h5]
        end

        %% Path 3: English Letters
        subgraph EL [Model 3: English Letters]
            D3[dataset: ASL Alphabet Imgs] -->|Script: train_eng_letters.py| AUG3(Image Augmentation)
            AUG3 -->|Resize 224x224| MN3{{MobileNetV2}}
            MN3 -->|Output| M3[File: english_letters.h5]
        end

        %% Path 4: Arabic Letters
        subgraph AL [Model 4: Arabic Letters]
            D4[dataset: ArSL Images] -->|Script: train_ara_letters.py| AUG4(Image Augmentation)
            AUG4 -->|Resize 224x224| MN4{{MobileNetV2}}
            MN4 -->|Output| M4[File: arabic_letters.h5]
        end
    end

    %% --- PHASE 2: THE APPLICATION (Main.py) ---
    subgraph Runtime_Phase [PHASE 2: REAL-TIME APPLICATION]
        direction TB
        
        %% Inputs
        Cam[Webcam Input] -->|Frame Stream| AppLogic{Main.py Logic}
        UserKey[User Keyboard Input] -->|Toggle 'L'| LangState[State: English / Arabic]
        UserKey -->|Toggle 'M'| ModeState[State: Word / Letter]
        
        %% The Switchboard
        LangState --> AppLogic
        ModeState --> AppLogic
        
        %% Routing Logic
        AppLogic -->|If English + Word| RunM1[Load: english_words.h5]
        AppLogic -->|If Arabic + Word| RunM2[Load: arabic_words.h5]
        AppLogic -->|If English + Letter| RunM3[Load: english_letters.h5]
        AppLogic -->|If Arabic + Letter| RunM4[Load: arabic_letters.h5]
        
        %% Processing
        RunM1 -->|Input: Landmarks| Pred1(Predict: 'HELLO')
        RunM2 -->|Input: Landmarks| Pred2(Predict: 'مرحبا')
        RunM3 -->|Input: Image| Pred3(Predict: 'A')
        RunM4 -->|Input: Image| Pred4(Predict: 'أ')
        
        %% Sentence Construction
        Pred1 & Pred2 & Pred3 & Pred4 --> Builder[Sentence Builder]
        
        Builder -->|Append| Screen[Display GUI: 'Hello...']
        Builder -->|Text-to-Speech| Speaker((Audio Output))
    end

    %% Link Phases (Conceptual)
    M1 -.-> RunM1
    M2 -.-> RunM2
    M3 -.-> RunM3
    M4 -.-> RunM4